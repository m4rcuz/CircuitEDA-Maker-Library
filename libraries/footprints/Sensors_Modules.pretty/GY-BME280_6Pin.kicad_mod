(footprint "GY-BME280_6Pin"
  (version 20240108)
  (generator pcbnew)
  (descr "GY BME280/BMP280 style 6-pin environmental sensor breakout, 15.3x11.5 mm, 2 mounting holes")
  (tags "module maker sensor bme280 bmp280")
  (attr through_hole)
  (fp_rect (start -7.65 -5.75) (end 7.65 5.75) (stroke (width 0.25) (type default)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -8.15 -6.25) (end 8.15 6.25) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
  (fp_text reference "REF**" (at 0 7.25) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "GY-BME280_6Pin" (at 0 -7.25) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (pad "1" thru_hole rect (at -6.35 -4.25) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -3.81 -4.25) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -1.27 -4.25) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 1.27 -4.25) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 3.81 -4.25) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at 6.35 -4.25) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (fp_text user "VCC" (at -6.35 -2.8) (layer "F.Fab") (effects (font (size 0.6 0.6))))
  (fp_text user "GND" (at -3.81 -2.8) (layer "F.Fab") (effects (font (size 0.6 0.6))))
  (fp_text user "SCL/SCK" (at -1.27 -2.8) (layer "F.Fab") (effects (font (size 0.6 0.6))))
  (fp_text user "SDA/SDI" (at 1.27 -2.8) (layer "F.Fab") (effects (font (size 0.6 0.6))))
  (fp_text user "CSB" (at 3.81 -2.8) (layer "F.Fab") (effects (font (size 0.6 0.6))))
  (fp_text user "SDO" (at 6.35 -2.8) (layer "F.Fab") (effects (font (size 0.6 0.6))))
  (fp_circle (center -5.15 3.25) (end -3.65 3.25) (stroke (width 0.2) (type default)) (fill none) (layer "F.SilkS"))
  (fp_circle (center 5.15 3.25) (end 6.65 3.25) (stroke (width 0.2) (type default)) (fill none) (layer "F.SilkS"))
  (model "${KIPRJMOD}/libraries/3dmodels/Sensors_Modules/GY-BME280_6Pin.wrl" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
