(footprint "BME280_4Pin_Module"
  (version 20240108)
  (generator pcbnew)
  (descr "Compact BME280 4-pin I2C breakout, 13.1x10 mm; header normalized to 2.54 mm pitch")
  (tags "module maker sensor bme280 i2c")
  (attr through_hole)
  (fp_rect (start -6.55 -5) (end 6.55 5) (stroke (width 0.25) (type default)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -7.05 -5.5) (end 7.05 5.5) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
  (fp_text reference "REF**" (at 0 6.5) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "BME280_4Pin_Module" (at 0 -6.5) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (pad "1" thru_hole rect (at -5.3 -3.81) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -5.3 -1.27) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -5.3 1.27) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -5.3 3.81) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (fp_text user "VIN" (at -3.2 -3.81) (layer "F.Fab") (effects (font (size 0.65 0.65))))
  (fp_text user "GND" (at -3.2 -1.27) (layer "F.Fab") (effects (font (size 0.65 0.65))))
  (fp_text user "SCL" (at -3.2 1.27) (layer "F.Fab") (effects (font (size 0.65 0.65))))
  (fp_text user "SDA" (at -3.2 3.81) (layer "F.Fab") (effects (font (size 0.65 0.65))))
  (model "${KIPRJMOD}/libraries/3dmodels/Sensors_Modules/BME280_4Pin_Module.wrl" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
