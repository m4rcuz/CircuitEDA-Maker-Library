(footprint "MCP2515_CAN_SPI_Module"
  (version 20240108)
  (generator pcbnew)
  (descr "Generic MCP2515 CAN controller module with TJA1050 transceiver, 1x7 SPI header, onboard CAN terminal and termination jumper; 40x28 mm")
  (tags "module maker")
  (attr through_hole)
  (fp_rect (start -20 -14) (end 20 14) (stroke (width 0.25) (type default)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -20.5 -14.5) (end 20.5 14.5) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
  (fp_text reference "REF**" (at 0 15.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "MCP2515_CAN_SPI_Module" (at 0 -15.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (pad "1" thru_hole rect (at -18.745 7.538) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -18.745 4.998) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -18.745 2.458) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -18.745 -0.082) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at -18.745 -2.622) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at -18.745 -5.162) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "7" thru_hole circle (at -18.745 -7.702) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask"))
  (fp_text user "INT" (at -16.5 7.538) (layer "F.Fab") (effects (font (size 0.7 0.7))))
  (fp_text user "SCK" (at -16.5 4.998) (layer "F.Fab") (effects (font (size 0.7 0.7))))
  (fp_text user "MOSI/SI" (at -15.6 2.458) (layer "F.Fab") (effects (font (size 0.7 0.7))))
  (fp_text user "MISO/SO" (at -15.6 -0.082) (layer "F.Fab") (effects (font (size 0.7 0.7))))
  (fp_text user "CS" (at -16.5 -2.622) (layer "F.Fab") (effects (font (size 0.7 0.7))))
  (fp_text user "GND" (at -16.5 -5.162) (layer "F.Fab") (effects (font (size 0.7 0.7))))
  (fp_text user "VCC" (at -16.5 -7.702) (layer "F.Fab") (effects (font (size 0.7 0.7))))
  (fp_text user "CANH / CANL terminal" (at 15.5 0 90) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_circle (center -17.5 11.5) (end -15.75 11.5) (stroke (width 0.2) (type default)) (fill none) (layer "F.SilkS"))
  (fp_circle (center 17.5 11.5) (end 19.25 11.5) (stroke (width 0.2) (type default)) (fill none) (layer "F.SilkS"))
  (fp_circle (center -17.5 -11.5) (end -15.75 -11.5) (stroke (width 0.2) (type default)) (fill none) (layer "F.SilkS"))
  (fp_circle (center 17.5 -11.5) (end 19.25 -11.5) (stroke (width 0.2) (type default)) (fill none) (layer "F.SilkS"))
  (model "${KIPRJMOD}/libraries/3dmodels/Communication_Modules/MCP2515_CAN_SPI_Module.wrl" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
